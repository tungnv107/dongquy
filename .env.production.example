# Copy to .env.production and replace all values. Use URL-safe random passwords.
DOMAIN=quy.example.com
ACME_EMAIL=ops@example.com
DB_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
DB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_APP_PASSWORD
MIGRATION_DATABASE_URL=postgresql://dongquy_owner:REPLACE_WITH_RANDOM_OWNER_PASSWORD@db:5432/dongquy?schema=public
DATABASE_URL=postgresql://dongquy_app:REPLACE_WITH_DIFFERENT_RANDOM_APP_PASSWORD@db:5432/dongquy?schema=public
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BANK_WEBHOOK_SECRET=
APP_PORT=3004
NPM_NETWORK=npm_proxy
